{
	"name": "usm-vlsi-tools for WSL",
	"image": "akilesalreadytaken/usm-vlsi-tools:latest",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"barakh.vscode-xschem-viewer",
				"charliermarsh.ruff"
			],
			"settings": {
				"[python]": {
					"editor.formatOnSave": true,
					"editor.defaultFormatter": "charliermarsh.ruff"
				}
			}
		}
	},
	"mounts": [
		{
			"source": "\\\\wsl.localhost\\${localEnv:WSL_DISTRO}\\tmp\\.X11-unix",
			"target": "/tmp/.X11-unix",
			"type": "bind"
		},
		{
			"source": "\\\\wsl.localhost\\${localEnv:WSL_DISTRO}\\tmp\\wslg",
			"target": "/mnt/wslg",
			"type": "bind"
		}
	],
	"containerEnv": {
		"SHELL": "/bin/bash",
		"PDK": "ihp-sg13g2",
		"DISPLAY": ":0",
		"LIBGL_ALWAYS_INDIRECT": "1"
	}
}
